    "chartjs-plugin-datalabels": "^2.2.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "luxon": "^3.6.1",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.2.0",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.9"
  },
  "devDependencies": {
