    "firebase": "^12.17.1",
    "firebase-admin": "^14.5.0",
    "luxon": "^3.6.1",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.2.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18"
